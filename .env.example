# Better Auth Configuration
# Generate a 32+ character secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-plus-character-secret-here"

# Base URL for auth callbacks
# Local: http://localhost:5173
# Production: https://bonfire-app.vercel.app
BETTER_AUTH_URL="http://localhost:5173"

# Vercel Postgres
# Connect Postgres in Vercel dashboard - these vars auto-inject in production
# For local dev, use your own Postgres URL
POSTGRES_URL="postgresql://user:password@localhost:5432/dbname"

# Optional: Resend for magic link emails
# Without these, magic links will be logged to console
# RESEND_API_KEY="re_..."
# EMAIL_FROM="noreply@yourdomain.com"
